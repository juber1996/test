# Copy this file to .env.local for local development.
# .env.local is git-ignored — never commit real secrets.
#
# On Vercel, set the same keys under:
#   Project → Settings → Environment Variables

# Public base URL. Used for metadataBase, sitemap.xml and robots.txt.
# Leave unset on Vercel and it falls back to your .vercel.app URL automatically.
# NEXT_PUBLIC_SITE_URL=https://your-app.vercel.app

# Shared secret for the on-demand revalidation endpoint:
#   POST /api/revalidate?path=/missions&secret=<this value>
REVALIDATE_SECRET=change-me-to-something-random
